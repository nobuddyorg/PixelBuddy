<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Crash reports stay on the device (#22). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="crash-reports/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="crash-reports/" />
    </device-transfer>
</data-extraction-rules>
