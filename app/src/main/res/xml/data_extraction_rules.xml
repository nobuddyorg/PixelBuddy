<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and newer. Only the settings (#8) and the pictures imported as app icons (#14) are backed up and
    transferred: with include rules everything else is left out, e.g. crash reports (#22). Caches are never backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.json" />
        <include domain="file" path="icon-images/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.json" />
        <include domain="file" path="icon-images/" />
    </device-transfer>
</data-extraction-rules>
