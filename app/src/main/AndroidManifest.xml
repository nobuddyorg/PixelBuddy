<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the long-press menu open the system's uninstall confirmation (#8). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Weather only (#11), and only while weather is on: see PRIVACY.md. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only if approximate location is chosen for the weather; asked at that moment. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Swipe down on home pulls down the notification shade (#10). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Merged from :feature:settings: SET_WALLPAPER for "Set as wallpaper" (#12). -->

    <!-- Package visibility: see launchable apps without QUERY_ALL_PACKAGES (#4). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".PixelBuddyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelBuddy">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_label" />

        <!--
            Opt-in lock service for the lock gesture (#16): runs only while the user turns it on in the
            accessibility settings, gets no events, can't read the screen. See LockService and PRIVACY.md.
        -->
        <service
            android:name=".LockService"
            android:exported="true"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>

        <!--
            Opt-in notification access for the notification dots and media controls (#24, #25): runs only while
            the user grants it and one of them is on. Notifications stay in memory. See NotificationService and
            PRIVACY.md.
        -->
        <service
            android:name=".NotificationService"
            android:exported="true"
            android:label="@string/notification_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
