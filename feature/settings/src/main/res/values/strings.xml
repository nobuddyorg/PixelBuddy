    <string name="notification_access_title">Notification access</string>
    <string name="notification_access_on">Granted</string>
    <string name="notification_access_off">Not granted: Android asks once you allow it.</string>
    <string name="notification_access_explanation">Android\'s notification access lets an app read every notification. PixelBuddy keeps them in memory only while they are shown: it never stores, logs or sends them. When everything here is off, PixelBuddy lets go of the access.</string>
    <string name="notification_access_allow">Allow notification access</string>
    <string name="notification_access_restricted">If Android says the setting is restricted: Settings → Apps → PixelBuddy → ⋮ → Allow restricted settings, then try again.</string>
    <string name="gesture_double_tap">Double tap on empty space</string>
    <string name="lock_service_title">Lock service</string>
    <string name="lock_service_on">On: the gesture locks the screen.</string>
    <string name="lock_service_off">Off: turn it on so the gesture can lock the screen.</string>
    <string name="lock_service_explanation">Android lets apps lock the screen only through an accessibility service. PixelBuddy\'s lock service does nothing else: it gets no accessibility events and can\'t see the screen, what you type or other apps. Fingerprint and face unlock keep working. It turns itself off when no gesture locks the screen any more.</string>
    <string name="lock_service_turn_on">Turn on in accessibility settings</string>
    <string name="lock_service_restricted">There, open Installed apps (or Downloaded apps) → PixelBuddy lock. If Android says the setting is restricted: Settings → Apps → PixelBuddy → ⋮ → Allow restricted settings, then try again.</string>

